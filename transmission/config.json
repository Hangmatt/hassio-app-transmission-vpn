{
    "name": "Transmission",
    "version": "1.4.4a",
    "stage": "experimental",
    "slug": "transmission",
    "description": "The torrent client for Hass.io with OpenVPN support",
    "url": "https://github.com/Hangmatt/hassio-addon-transmission",
    "webui": "http://[HOST]:[PORT:9091]/transmission/web/",
    "startup": "services",
    "init": false,
    "ingress": true,
    "ingress_port": 8099,
    "panel_icon": "mdi:progress-download",
    "arch": [
        "aarch64",
        "amd64"
    ],
    "map": [
        {
            "type": "app_config",
            "read_only": false
        },
        {
            "type": "ssl"
        },
        {
            "type": "media",
            "read_only": false
        },
        {
            "type": "share",
            "read_only": false
        }
    ],
    "boot": "auto",
    "ports": {
        "9091/tcp": "9091",
        "51413/tcp": "51413",
        "51413/udp": "51413"
    },
    "ports_description": {
        "9091/tcp": "Web UI port (Not required for Hass.io Ingress)",
        "51413/tcp": "Torrent port",
        "51413/udp": "Torrent port"
    },
    "privileged": [
        "NET_ADMIN"
    ],
    "devices": [
        "/dev/net/tun"
    ],
    "hassio_api": true,
    "homeassistant_api": false,
    "host_network": false,
    "options": {
        "log_level": "info",
        "authentication_required": true,
        "WebUI Login": {
            "username": "",
            "password": ""
        },
        "download_dir": "/media/downloads",
        "incomplete_dir": "/media/incomplete",
        "local_port_forwarding": false,
        "local-port": 51413,
        "openvpn_enabled": false,
        "kill_switch": true,
        "port_forwarding": false,
        "openvpn_config": "",
        "openvpn credentials": {
            "openvpn_username": "",
            "openvpn_password": ""
        }
    },
    "schema": {
        "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
        "authentication_required": "bool",
        "WebUI Login": {
            "username": "str",
            "password": "password"
        },
        "download_dir": "match(^\/(share|media))",
        "incomplete_dir": "match(^\/(share|media))",
        "local_port_forwarding": "bool",
        "local-port": "port",
        "openvpn_enabled": "bool",
        "kill_switch": "bool",
        "port_forwarding": "bool",
        "openvpn_config": "str",
        "openvpn credentials": {
            "openvpn_username": "str",
            "openvpn_password": "password"
        }
    },
    "environment": {
        "LOG_FORMAT": "{LEVEL}: {MESSAGE}"
    }
}
